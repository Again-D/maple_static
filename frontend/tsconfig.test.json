{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.test-dist",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "noEmit": false,
    "incremental": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-dist"
  ]
}
