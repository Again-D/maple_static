NEXON_API_KEY=replace-with-your-nexon-api-key
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/maple_growth
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-db-password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
APP_TIMEZONE=Asia/Seoul
APP_SNAPSHOT_CRON=0 0 4 * * *
APP_SCHEDULER_DUPLICATE_WAIT_SECONDS=300
APP_OPERATIONS_API_TOKEN=replace-with-an-operations-token
APP_COLLECTION_RETRY_CRON=0 */15 * * * *
APP_COLLECTION_RETRY_BATCH_SIZE=20
APP_COLLECTION_RETRY_MAX_ATTEMPTS=3
APP_COLLECTION_RETRY_INITIAL_BACKOFF_SECONDS=300
APP_COLLECTION_RETRY_LEASE_SECONDS=900
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_NEXON_BASE_URL=https://open.api.nexon.com
APP_NEXON_TIMEOUT_SECONDS=10
